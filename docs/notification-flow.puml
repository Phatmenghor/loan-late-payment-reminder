@startuml Loan Late Payment Notification Flow
!theme plain
skinparam backgroundColor #f9f9f9
skinparam sequenceParticipant underline
skinparam activity {
    BackgroundColor #e1f5ff
    BorderColor #01579b
    FontColor #000
}

title Loan Late Payment Notification System - Complete Flow

participant "Oracle View" as ORACLE
participant "Spring Boot\nApplication" as APP
participant "Notification\nQueue Table" as QUEUE
participant "Payload\nBuilder" as PAYLOAD
participant "CPB API\n/SendOTT" as API
participant "Notification\nLog Table" as LOG
participant "Processing\nStatus Table" as STATUS
database "PostgreSQL" as DB

== Daily Scheduled Processing ==

APP -> APP: processPendingSmsNotifications()\nat scheduled time

alt Local Profile
    APP -> APP: Use TestDataHelper\nfor 2 test records
else Production Profile
    ORACLE -> APP: SELECT from\nVIEW_LOAN_LATE_REMINDER\n(3,950+ records)
end

APP -> APP: Group records into\nbatches (batch-size: 20)

== Store to Queue ==

loop For each record
    APP -> PAYLOAD: buildJsonPayload(\nphoneNumber, message)
    PAYLOAD -> APP: Return JSON payload

    APP -> QUEUE: Insert record with\nstatus=PENDING\njsonPayload stored
    QUEUE -> DB: CREATE notification_queue
end

APP -> APP: log.info("Queued: X records\nwith status=PENDING")

== Async Batch Processing ==

APP -> APP: processBatchAsync()\nusing @Async(notificationExecutor)\nwith transaction context

par Parallel Batch Workers
    APP -> APP: Worker 1: Process records 1-20
    APP -> APP: Worker 2: Process records 21-40
    APP -> APP: Worker 3: Process records 41-60
end

== For Each Record ==

loop processSingleBatchAsync
    APP -> APP: Check if already SUCCESS\nfindByCustomerIdAndPhone()

    alt Already Processed
        APP -> APP: Skip this record
    else New Record
        APP -> API: POST /SendOTT\n{json_payload}

        alt API Success Response
            API -> APP: Return response with status
            APP -> QUEUE: Native UPDATE query:\nstatus=SUCCESS\nprocessed_at=NOW()\njsonPayload retained
            QUEUE -> DB: UPDATE notification_queue

            APP -> LOG: Build NotificationLog\nwith status=SUCCESS
            LOG -> DB: CREATE notification_log

            APP -> APP: successCount++

        else API Failure
            APP -> APP: Catch exception
            APP -> QUEUE: Native UPDATE query:\nstatus=FAILURE\nfailure_reason=error\nretry_count++
            QUEUE -> DB: UPDATE notification_queue

            APP -> LOG: Build NotificationLog\nwith status=FAILURE
            LOG -> DB: CREATE notification_log

            APP -> APP: failureCount++
        end
    end
end

== Mark Completion ==

APP -> QUEUE: countFailureByReportDate(date)
QUEUE -> DB: Count FAILURE records

alt All SUCCESS (failureCount == 0)
    APP -> STATUS: Create ProcessingStatus\nreport_date, total, success,\nfailure, is_complete=true\nCompleted_at=NOW()
    STATUS -> DB: CREATE notification_processing_status

    APP -> APP: log.info("SUCCESS:\nAll SMS delivered")

else Some FAILURES
    APP -> APP: log.info("INCOMPLETE:\nX failures for retry")
end

== Logging Summary ==

DB -> LOG: notification_log table contains:\n✓ Phone numbers\n✓ Customer IDs\n✓ JSON payloads\n✓ Status (SUCCESS/FAILURE)\n✓ Timestamps\n✓ Arrangement IDs

== Daily Auto-Cleanup (2 AM) ==

APP -> APP: @Scheduled(cron="0 0 2 * * *")\ncleanupOldQueueRecords()

APP -> QUEUE: DELETE FROM notification_queue\nWHERE status='SUCCESS'\nAND created_at < 2 days ago\nAND is_deleted=false

QUEUE -> DB: DELETE old queue records

APP -> APP: Keep permanent audit\nin notification_log table

APP -> APP: log.info("Queue cleanup:\nDeleted X records")

== Key Features ==

note right of APP
  ✓ Soft Delete Pattern (is_deleted flag)
  ✓ Transaction Management (@Transactional)
  ✓ Async Processing (Spring @Async)
  ✓ Native SQL Updates (bypass ORM lock issues)
  ✓ Optimistic Locking Retry (3 attempts)
  ✓ Centralized Constants (NotificationConstants)
  ✓ Comprehensive Logging (all payloads stored)
  ✓ Cache Processing Status
  ✓ Batch Processing (20 records per batch)
  ✓ Multi-threaded Execution (10 max threads)
  ✓ Exponential Backoff on Retry
  ✓ JSON Payload Auditing
end note

== Data Flow Summary ==

note right of DB
  **notification_queue**
  - Working queue (2 days only)
  - Stores: customer, phone, payload, status
  - Auto-deleted after 2 days

  **notification_log**
  - Permanent audit trail
  - Stores: all delivery details + JSON
  - Kept forever for compliance

  **notification_processing_status**
  - Daily summary
  - Tracks: total, success, failure counts
  - Caching for repeated requests
end note

@enduml
